# 이 파일은 이름만 적는다. 값은 `.env.local` 에 넣고, 그 파일은 커밋하지 않는다.
# Vercel 에는 같은 이름으로 Project Settings > Environment Variables 에 넣는다.

# Supabase > Project Settings > API. anon key 는 브라우저에 공개되는 값이다.
# 실제 접근 통제는 DB 의 RLS 가 한다(supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 이 배포본의 주소. 로컬은 http://localhost:3000, 운영은 Vercel 주소.
# Supabase > Authentication > URL Configuration 의 Redirect URLs 에
# `${SITE_URL}/auth/callback` 이 있어야 카카오 로그인 후 돌아올 수 있다.
SITE_URL=

# 카카오 로그인 키는 여기 넣지 않는다. Supabase > Authentication > Providers > Kakao 에 넣는다.
