# 이 파일은 이름만 적는다. 값은 `.env.local` 에 넣고, 그 파일은 커밋하지 않는다.
# Vercel 에는 같은 이름으로 Project Settings > Environment Variables 에 넣는다.

# Supabase > Project Settings > API. anon key 는 브라우저에 공개되는 값이다.
# 실제 접근 통제는 DB 의 RLS 가 한다(supabase/migrations).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 이 배포본의 주소. 로컬은 http://localhost:3000, 운영은 Vercel 주소.
# 카톡 공유 링크와 미리보기 이미지 주소를 만들 때 쓴다.
SITE_URL=

# Vercel Cron 비밀값(아무 긴 문자열). Vercel 에 같은 이름으로 넣으면 Cron 요청에 실려 온다.
# 비워 두면 /api/cron/keep-alive 를 누구나 부를 수 있다(DB 핑만 보내므로 해는 없다).
CRON_SECRET=

# Supabase > Project Settings > API Keys 의 service_role(서버 전용) 키. 개인 링크로 들어올 때 로그인 계정을
# 만들고 세션을 여는 데만 쓴다(docs/PLAN.md §4). 🔴 RLS 를 건너뛰는 비밀이다 — NEXT_PUBLIC_ 을 붙이지 않는다.
# 비워 두면 개인 링크 화면이 이 키가 빠졌다고 알려 준다(나머지 기능은 그대로 돈다).
SUPABASE_SERVICE_ROLE_KEY=
